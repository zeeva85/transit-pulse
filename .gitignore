node_modules/

# Environment & secrets (catch-all + explicit overrides)
.env
.env.*
!.env.example
*.env
secrets.json
secrets.*.json
config.local.*

# Runtime data
data/
*.jsonl
*.parquet

# Learned/generated GTFS supplements
gtfs_static/extended_shapes.txt
gtfs_static/extended_routes.txt
gtfs_static/unknown_observations.*

# Data / GTFS directories for additional collectors started with
# FEED_SOURCE + DATA_DIR + GTFS_DIR. Pure caches — a non-primary collector
# re-downloads its static feed from api.data.gov.my on first boot.
data-*/
gtfs-*/

# Credentials & keys (never want these in any repo, ever)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
.ssh/
.npmrc
.yarnrc
.yarnrc.yml
.netrc

# OS / editor cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.log
npm-debug.log*
*.swp
*.swo
.vscode/
.idea/
.history/

# Data archives / binary dumps
*.gz
*.tar
*.tgz
*.zip
*.bz2
*.pb

# Build artifacts (future-proof)
dist/
build/
coverage/
.cache/
tmp/
temp/

# Markdown notes stay local — never commit them.
# Covers assistant files (CLAUDE.md), internal audit docs (SECURITY.md,
# PRIVACY.md) and any generated review/scratch write-ups. README.md is the
# one deliberate exception: it is this public repo's front page on GitHub.
*.md
!README.md
.claude/
